# Master switch for all paid AI calls (extraction, grading, server TTS/STT).
# false → saved question banks still work; grading uses word matching; the
# browser's own voice/speech recognition is used. Default: true.
# AI_ENABLED=true

# Postgres for question banks. Heroku Postgres sets this automatically.
# Without it, banks are kept in memory and lost on restart.
# DATABASE_URL=postgres://user:password@localhost:5432/random_questions

# ── Accounts ────────────────────────────────────────────────────────────────
# Base URL used in invitation emails (required by `npm run invite`).
# APP_URL=https://your-app.herokuapp.com
# Sign-up is by invitation only; set true to also allow open sign-up.
# SIGNUPS_ENABLED=false
# Invitation emails via Resend (https://resend.com). Without these, invitations
# can only be created with `npm run invite`, which prints the link.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Random Questions <no-reply@yourdomain.com>

# ── Rate limits (per minute; whole numbers ≥ 1) ─────────────────────────────
# RATE_LIMIT_REQUESTS_PER_MIN=1000        # every request, per user (per IP before login)
# RATE_LIMIT_LOGIN_GLOBAL_PER_MIN=20      # login/sign-up attempts, all users together
# RATE_LIMIT_LOGIN_IP_PER_MIN=5           # login/sign-up attempts, per IP
# RATE_LIMIT_LOGIN_PAGE_GLOBAL_PER_MIN=20 # login screen loads, all visitors together
# RATE_LIMIT_LOGIN_PAGE_IP_PER_MIN=5      # login screen loads, per IP
# RATE_LIMIT_STATIC_IP_PER_MIN=600        # build assets (/assets/*), per IP

# ── Behind Cloudflare (or another proxy in front of Heroku) ─────────────────
# TRUST_PROXY_HOPS=2      # 1 = Heroku only (default); 2 = Cloudflare → Heroku
# ORIGIN_SECRET=...       # Cloudflare adds X-Origin-Secret; requests without it get 403

# AI Provider — openai | anthropic | mock (default: openai)
AI_PROVIDER=openai

# Required when AI_PROVIDER=openai (or AI_FALLBACK_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-...

# Required when AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: fill TTS/STT gaps when primary provider lacks them (e.g. anthropic)
# AI_FALLBACK_PROVIDER=openai

# Optional: override specific models
# OPENAI_EXTRACTION_MODEL=gpt-4o
# OPENAI_GRADING_MODEL=gpt-4o-mini
# ANTHROPIC_EXTRACTION_MODEL=claude-opus-4-5
# ANTHROPIC_GRADING_MODEL=claude-haiku-4-5

# Optional: dedicated TTS provider (default: same as AI_PROVIDER)
# Set to "elevenlabs" for significantly more natural-sounding voice.
# TTS_PROVIDER=elevenlabs

# ElevenLabs — required when TTS_PROVIDER=elevenlabs
# Get your API key at https://elevenlabs.io
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Rachel (default) — browse voices at elevenlabs.io/voice-library
# ELEVENLABS_MODEL=eleven_multilingual_v2     # handles EN + ES automatically

# Optional: OpenAI TTS fallback voice and quality (used when TTS_PROVIDER=openai)
# Models: tts-1 (faster, cheaper) | tts-1-hd (higher quality)
# Voices: alloy | echo | fable | onyx | nova | shimmer
# OPENAI_TTS_MODEL=tts-1-hd
# OPENAI_TTS_VOICE=nova

#PORT=3001

# Optional: route all AI API calls through an HTTP/HTTPS proxy
# Direct proxy:  HTTPS_PROXY=http://proxy.example.com:8080
# PAC file:      HTTPS_PROXY=pac+http://pac.example.com/proxy.pac
#HTTPS_PROXY=pac+http://pac.tsl.telus.com/standard.pac
